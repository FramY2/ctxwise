{
  "name": "@framy2/ctxwise",
  "version": "0.4.0",
  "description": "CtxWise: local-first context observability, drift detection, profiles, and usage receipts for OpenAI Codex.",
  "type": "module",
  "bin": {
    "ctxwise": "dist/cli.js",
    "ctxray": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data",
    "assets",
    "plugins",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "benchmark:live": "npm run build && node scripts/run-live-benchmark.mjs --community --full",
    "benchmark:preflight": "npm run benchmark:reproduce",
    "benchmark:quick": "npm run benchmark:reproduce -- --task js-nullish",
    "benchmark:reproduce": "npm run build && node scripts/run-live-benchmark.mjs --community",
    "check": "npm run format:check && npm run typecheck && npm run test:coverage",
    "demo:render:windows": "powershell -ExecutionPolicy Bypass -File scripts/render-demo.ps1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run tests/e2e",
    "typecheck": "tsc --noEmit",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "codex",
    "openai",
    "context",
    "tokens",
    "observability",
    "drift-detection",
    "codex-cli",
    "developer-tools",
    "local-first"
  ],
  "license": "Apache-2.0",
  "author": "CtxWise contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FramY2/ctxwise.git"
  },
  "bugs": {
    "url": "https://github.com/FramY2/ctxwise/issues"
  },
  "homepage": "https://github.com/FramY2/ctxwise#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "npm@10.2.5",
  "dependencies": {
    "commander": "15.0.0",
    "picocolors": "1.1.1",
    "smol-toml": "1.8.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
